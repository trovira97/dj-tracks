# Copy to .env and fill in.  NEVER commit .env (it's in .gitignore).

# ── Discord (from https://discord.com/developers/applications) ─────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1518622366601838602
DISCORD_DONOR_ROLE_ID=1518622689583956109

# Where Discord redirects after the user authorizes.  Must match the
# value registered in the Developer Portal → OAuth2 → Redirects.
# Local dev: http://localhost:8732/discord/callback
# Production: https://<your-domain>/discord/callback
DISCORD_REDIRECT_URI=http://localhost:8732/discord/callback

# ── Ko-fi (from https://ko-fi.com/manage/webhooks) ─────────────────────────
KOFI_VERIFICATION_TOKEN=

# Optional: Discord channel ID where donation announcements are posted.
# Leave empty to disable public announcements.  Click the channel in
# Discord (Developer Mode ON) → Copy Channel ID.
KOFI_ANNOUNCE_CHANNEL_ID=

# ── Storage ────────────────────────────────────────────────────────────────
DB_PATH=donors.db
